        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nclass Utilizador {\n    - nome : String\n    - matricula : String\n    - perfil : String\n    + autenticar() : boolean\n}\n\nclass GestorCozinha {\n    + aprovarReceita() : void\n    + aprovarAjuste() : void\n}\n\nclass Ingrediente {\n    - nome : String\n    - unidadeMedida : String\n    - stockMinimo : double\n    + verificarStockBaixo() : boolean\n    + getStockTotal() : double\n}\n\nclass LoteIngrediente {\n    - codigoLote : String\n    - dataValidade : Data\n    - quantidadeAtual : double\n    + darBaixa(qtd) : void\n    + estaVencido() : boolean\n}\n\nclass Receita {\n    - nomePrato : String\n    - rendimentoPorcoes : int\n    - custoEstimado : double\n    + calcularCustoTotal() : double\n    + darBaixaEmStock(porcoes) : void\n}\n\nclass ItemReceita {\n    - quantidadeNecessaria : double\n    - unidade : String\n    + calcularCustoItem() : double\n}\n\nclass Fornecedor {\n    - razaoSocial : String\n    - cnpj : String\n    - telefone : String\n    + listarIngredientesFornecidos() : List\n}\n\nclass MovimentoStock {\n    - dataHora : DataHora\n    - quantidade : double\n    - tipoMovimento : TipoMovimento\n    + registrarMovimento() : void\n}\n\n&#39; Relacionamentos\nUtilizador &lt;|-- GestorCozinha : Herança\nIngrediente \&quot;1\&quot; *-- \&quot;1..*\&quot; LoteIngrediente : Composição\nReceita \&quot;1\&quot; *-- \&quot;1..*\&quot; ItemReceita : Composição\nItemReceita \&quot;1..*\&quot; -- \&quot;1\&quot; Ingrediente : Utiliza\nLoteIngrediente \&quot;1\&quot; -- \&quot;0..*\&quot; MovimentoStock : Sofre\nUtilizador \&quot;1\&quot; -- \&quot;0..*\&quot; MovimentoStock : Realiza\nFornecedor \&quot;1\&quot; -- \&quot;1..*\&quot; Ingrediente : Fornece\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="J8ERvO9icFboK68wd2DP-1">
